# cluster-placer.service — cluster placement scheduler (docs/cluster.md#groups-and-placement).
# Starts the placer member API, follows registry membership, consumes node_list
# WATCH_LIST and serves Place/verify-key for registry callers. Operator-managed.
[Unit]
Description=kuasar cluster-ctl placer (placement scheduler)
After=network-online.target cluster-registry.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cluster-ctl placer --config /etc/cluster-ctl/placer.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
