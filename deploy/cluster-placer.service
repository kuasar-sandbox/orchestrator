# cluster-placer.service — cluster placement scheduler (cluster-placer.md).
# Starts the stateless Provider/Policy and RandomN planning API used by Registry.
# Node Catalog authority remains in the Registry System Group. Operator-managed.
[Unit]
Description=kuasar cluster-ctl placer (placement scheduler)
After=network-online.target cluster-registry.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cluster-ctl placer --config /etc/cluster-ctl/placer.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
