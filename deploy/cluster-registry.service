# cluster-registry.service — cluster control-plane registry (docs/cluster.md):
# execution metadata, authentication/selection and node-link service. Run Registry
# and Router, plus optional Placer, as separate processes with their own configs.
# Operator-managed.
[Unit]
Description=kuasar cluster-ctl registry (metadata, selection and node-link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/run-cluster-ctl registry --config /etc/cluster-ctl/registry.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
