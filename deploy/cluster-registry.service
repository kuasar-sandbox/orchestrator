# cluster-registry.service — cluster control-plane registry (cluster.md §4.1):
# durable state authority + node-link hub. One of three independent roles; run it
# (and router/scaler) as separate processes, each with its own config file.
# Operator-managed.
[Unit]
Description=kuasar cluster-ctl registry (state authority + node-link hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cluster-ctl registry --config /etc/cluster-ctl/registry.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
