# cluster-scaler.service — cluster placement scheduler (cluster-scaler.md).
# Starts the scaler member API, follows registry membership, consumes node_list
# WATCH_LIST and serves Place/verify-key for registry callers. Operator-managed.
[Unit]
Description=kuasar cluster-ctl scaler (placement scheduler)
After=network-online.target cluster-registry.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cluster-ctl scaler --config /etc/cluster-ctl/scaler.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
