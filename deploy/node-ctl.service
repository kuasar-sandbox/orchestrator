# node-ctl conductor unit — the API/control host + optional node resource controller.
# It launches sandbox/build runner template instances keyed by run-id
# over systemd D-Bus, so it needs the system bus and cgroup write access. Start
# independently of the Proxy data service. node-proxy.service starts after this
# unit so it can register through config_socket; do not add a reverse dependency.
[Unit]
Description=kuasar node-ctl conductor (API + lifecycle + node resource control)
After=network-online.target cache-ctl.service store-ctl.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node-ctl conductor serve --config /etc/node-ctl/conductor.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
