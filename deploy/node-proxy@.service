# node-proxy@.service — external data-plane proxy worker (serve.yaml proxy.mode=external).
#
# Run one or more instances (node-proxy@1, @2, ...). All instances read one shared
# /etc/node-ctl/proxy.yaml (config_socket / data_listen / tls / auth / park_timeout)
# and differ only by --id %i: each binds the same data_listen with SO_REUSEPORT (the
# kernel load-balances connections) and registers on node-ctl's config-socket plugin
# plane under that unique id, holding the connection open as its route stream + lease.
# node-ctl needs NO static socket list — it learns workers from their registrations
# and forwards by sandbox-id hash over the live set:
#
#   # serve.yaml
#   proxy:
#     mode: external
#
# Operator-managed (node-ctl does NOT auto-install this unit). The worker is
# stateless: it serves only what it syncs over the registration stream, so a
# crash/restart re-registers and re-syncs from scratch. It must run on the same node
# as node-ctl (it dials the config-socket + per-sandbox envd UDS / floatingip
# locally). Optionally gate registration with serve.yaml paths.plugin_pidfile.
[Unit]
Description=kuasar node-ctl data-plane proxy %i
After=network-online.target node-ctl.service
Wants=network-online.target

[Service]
Type=exec
# --config points at the shared worker config; --id is this worker's unique plugin
# id (the gateway-forward --socket defaults to <dir(config_socket)>/<id>.sock).
# --metrics-listen is per-instance (ports must differ across workers). Add --mmds on
# exactly one instance when serve runs envd in FC mode (serve.yaml mmds.enabled).
ExecStart=/usr/bin/node-ctl proxy \
  --config=/etc/node-ctl/proxy.yaml \
  --id=proxy-%i \
  --metrics-listen=127.0.0.1:909%i
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
