# Independent Collector/metrics service. No Requires/BindsTo relationship makes
# conductor or Proxy lifecycle depend on telemetry availability.
[Unit]
Description=kuasar node-ctl sandbox telemetry
After=network-online.target node-ctl.service
Wants=network-online.target

[Service]
Type=exec
# Host OTLP is group-local; the public Guest OTLP uses independent TCP listeners.
# Install deploy/node-telemetry.sysusers.conf and grant trusted Host services
# supplementary membership in kuasar-telemetry.
Group=kuasar-telemetry
RuntimeDirectory=sandbox-telemetry
RuntimeDirectoryMode=0770
UMask=0007
ExecStart=/usr/bin/node-ctl telemetry serve --config=/etc/node-ctl/telemetry.yaml
Restart=always
RestartSec=1
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
