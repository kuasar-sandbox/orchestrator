# repo path followed by the binary/runtime file name under bin/<arch>/.
# This manifest only drives release-builder/bin/<arch>/ assembly for local e2e,
# demos, and release packaging. It is not the release package layout.
guest-runtime/native-deps mkfs.erofs
guest-runtime/native-deps fsck.erofs
guest-runtime/native-deps vmlinux
guest-runtime/native-deps envd
accelerator              manifest-ctl
accelerator              store-ctl
accelerator              cache-ctl
guest-runtime            flatten-ctl
sandboxer                sandbox-ctl
sandboxer                sandbox-init
sandboxer                cloud-hypervisor
guest-runtime            sandbox-runtime.erofs
orchestrator             node-ctl
orchestrator             cluster-ctl
orchestrator             node-stub-ctl
connector                connector-ctl
orchestrator             e2b-key-ctl
